Cell[CellGroupData[{

Cell["Frequency Response in High-Pass Arrangement", "Subsection",
 CellChangeTimes->{{3.984435644599784*^9, 
  3.9844356708627234`*^9}},ExpressionUUID->"45b4bfee-dcaf-458c-bcdc-\
eeb0182acc94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vOutHighPass", "[", "f_", "]"}], ":=", 
  RowBox[{"vIn", " ", 
   FractionBox["r", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      SuperscriptBox["r", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{"2", " ", "Pi", " ", "f", " ", "c"}]], ")"}], "2"]}], 
     "]"}]]}]}]], "Input",
 CellChangeTimes->{{3.984435253453271*^9, 3.984435340127617*^9}, {
  3.984435478982038*^9, 3.984435480520537*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"dc526478-d889-4150-83b3-46a9efc9f5e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LogLogPlot", "[", 
  RowBox[{
   RowBox[{"vOutHighPass", "[", "f", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"f", ",", "10", ",", " ", "10000"}], "}"}], ",", " ", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(V\), \(out\)]\)\>\""}], "}"}]}]}], 

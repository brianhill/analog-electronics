Cell[CellGroupData[{

Cell["Frequency Response in Low-Pass Arrangement", "Subsection",
 CellChangeTimes->{{3.984435644599784*^9, 
  3.9844356621926727`*^9}},ExpressionUUID->"51eb1d85-5f37-4bdc-a3d1-\
1d8823d083bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vOutLowPass", "[", "f_", "]"}], ":=", 
  RowBox[{"vIn", " ", 
   FractionBox[
    FractionBox["1", 
     RowBox[{"2", " ", "Pi", " ", "f", " ", "c"}]], 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      SuperscriptBox["r", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{"2", " ", "Pi", " ", "f", " ", "c"}]], ")"}], "2"]}], 
     "]"}]]}]}]], "Input",
 CellChangeTimes->{{3.984435253453271*^9, 3.984435340127617*^9}, {
  3.984435478982038*^9, 3.984435501215425*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"2fc8941d-fdbf-4624-8105-febb85f6061c"],

Cell[CellGroupData[{


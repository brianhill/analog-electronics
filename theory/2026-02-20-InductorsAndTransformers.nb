Cell[TextData[StyleBox["The idea of this handout is to get more understanding \
of how transformers harness the properties of magnetic fields to change \
voltages from one level to another. Every wall bug you own (to charge a \
cellphone, laptop, etc.) has a transformer in it as its most important \
component.",
 FontSlant->"Italic"]], "Subtitle",
 CellChangeTimes->{{3.980559811983774*^9, 
  3.980559864164859*^9}},ExpressionUUID->"16f0464b-b92f-4baf-af70-\
9ed2ec7eb52e"],

Cell[CellGroupData[{

Cell["The Magnetic Field and Magnetic Flux", "Section",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQBGIQvejASQaRRW8dr7++wQiiHwcpzpgGpKUMf80E0eFt

  3.980566050067645*^9, 3.9805660819430857`*^9}, {3.980599715285833*^9, 
  3.980599715570154*^9}},ExpressionUUID->"89c5ad7c-cb13-4704-ba54-\
96b6733b2c82"]
}, Open  ]]

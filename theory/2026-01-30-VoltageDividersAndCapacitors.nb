323b79e4a18e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"47", " ", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"10", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v0", "=", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dt", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vExact", "[", "t_", "]"}], ":=", 
  RowBox[{"v0", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "t"}], "/", 
     RowBox[{"(", 
      RowBox[{"r", " ", "c"}], ")"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iExact", "[", "t_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox["10", "3"], 
   RowBox[{
    RowBox[{"vExact", "[", "t", "]"}], "/", 
    "r"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qExact", "[", "t_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox["10", "6"], " ", "c", " ", 
   RowBox[{"vExact", "[", "t", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dqExact", "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{"qExact", "[", "t", "]"}], "-", 
   RowBox[{"qExact", "[", 
    RowBox[{"t", "+", "dt"}], "]"}]}]}]}], "Input",

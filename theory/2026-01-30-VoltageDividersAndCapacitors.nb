  3.978771476691267*^9}, {3.9787715944965487`*^9, 3.978771683193063*^9}, {
  3.978771850964213*^9, 
  3.978771884002438*^9}},ExpressionUUID->"ade74dc3-7a5f-45ba-a06d-\
0955387b8964"],


Cell[TextData[{
 "We learned that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "e92dce72-6270-4cad-b6dc-78de143c64a5"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "7449b412-9a42-47a0-b172-8cb2024ed854"],
 " connected in series act exactly like a resistor with size ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "1"], "+", 
    SubscriptBox["R", "2"]}], TraditionalForm]],ExpressionUUID->
  "e5ef17fc-8dc5-4c21-82cc-46a39e8c91ba"],
 ". What does that mean!? It means that the current through a combination of \
two resistors also obeys Ohm\[CloseCurlyQuote]s Law, but with the constant of \
proportionality being ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "1"], "+", 
    SubscriptBox["R", "2"]}], TraditionalForm]],ExpressionUUID->
  "0e13d92e-b361-4daf-9f06-122e4a2390da"],
 ".\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "0"], "=", 
    RowBox[{"I", "(", 
     RowBox[{
      SubscriptBox["R", "1"], "+", 
      SubscriptBox["R", "2"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "9e166af0-1cf8-4196-ac50-a9d91aec53ec"],
 "\n\nSolving for ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],ExpressionUUID->
  "7466948c-14ab-4cf5-8a7a-db9cc67c8970"],
 ", \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", "=", 
    FractionBox[
     SubscriptBox["V", "0"], 
     RowBox[{
      SubscriptBox["R", "1"], "+", 
      SubscriptBox["R", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "7bccc873-8ef2-40c4-9a8c-ce45c94ad388"],
 "\n\nAs an example, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "0"], "=", 
    RowBox[{"6", 
     StyleBox["V",
      FontSlant->"Plain"]}]}], TraditionalForm]],ExpressionUUID->
  "861a8b80-cc68-4c13-9bd1-46f34668a17a"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "1"], "=", 
    RowBox[{"1", "k\[CapitalOmega]"}]}], TraditionalForm]],ExpressionUUID->
  "02d48705-1726-4ad4-a0ab-c2a702ce359d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "2"], "=", 
    RowBox[{"3", "k\[CapitalOmega]"}]}], TraditionalForm]],ExpressionUUID->
  "66b43629-2425-4973-8e41-8648525c9be9"],
 ", what is ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]],ExpressionUUID->
  "d1d37045-a78c-4dd8-adec-8c687a45cecc"],
 "? Answer conveniently in mA."
}], "Text",
 CellChangeTimes->{{3.978765881799527*^9, 3.978765948356965*^9}, {
  3.978766003951593*^9, 3.9787660813706923`*^9}, {3.978766131412366*^9, 
  3.978766155786352*^9}, {3.9787661926741457`*^9, 3.978766313367745*^9}, {
  3.9787697766339083`*^9, 3.978769777036374*^9}, {3.9793732984912357`*^9, 
  3.9793733029725018`*^9}, {3.979373334627737*^9, 
  3.979373342049096*^9}},ExpressionUUID->"cf9f718e-760b-49bb-915e-\
a42b85f94395"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Voltage Dividers", "Section",
 CellChangeTimes->{{3.9772897343047647`*^9, 3.977289742778789*^9}, {
  3.977557185041368*^9, 3.977557199818494*^9}, {3.977560920391399*^9, 
  3.9775609285410013`*^9}, {3.977561704893649*^9, 3.9775617124536877`*^9}, {
  3.977562699357638*^9, 3.977562712075577*^9}, {3.977935734236527*^9, 
  3.977935734945239*^9}, {3.977939102048142*^9, 3.977939102844123*^9}, {
  3.977989437232789*^9, 3.977989437465143*^9}, {3.977989470213393*^9, 
  3.977989508390332*^9}, {3.97798954149605*^9, 3.977989543660515*^9}, {
  3.977990021719898*^9, 3.977990078606063*^9}, {3.977992894877846*^9, 
  3.97799289522244*^9}, {3.978139264324004*^9, 3.978139271216731*^9}, {
  3.978139302793354*^9, 3.978139304471149*^9}, {3.978766340445903*^9, 
  3.978766347061178*^9}},ExpressionUUID->"f5e83d72-7e0b-48d6-b82d-\
07013797c860"],

Cell[TextData[{
 "A key formula from the previous section was\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", "=", 
    FractionBox[
     SubscriptBox["V", "0"], 
     RowBox[{
      SubscriptBox["R", "1"], "+", 
      SubscriptBox["R", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "1d8c2a37-7e71-4ece-a535-7fd86ef80569"],
 "\n\nThink about the resistor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "845be71d-6a6f-4780-849d-720bd264a3bd"],
 ". We usually declare the minus side of the battery to be at ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "V"}],
    FontSlant->"Plain"], TraditionalForm]],ExpressionUUID->
  "94083a57-cd9b-416e-bd7b-4b97132ebddc"],
 ", so that means the lower connector of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "2823420c-f99e-402f-8d05-302c35700724"],
 " is at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", 
    StyleBox["V",
     FontSlant->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "b39c64e7-d307-4a8e-acb4-1cbae0aea133"],
 ".\n\nWhat voltage is the upper connector of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "68f4ccfb-83c2-4043-9419-5a96ded98697"],
 " at (the one that connects ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "66a3b050-127b-4f8c-8a90-afecf4f8f559"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "787cf0ff-09b6-46e3-bdcf-564201d81e1c"],
 ")?\n\nI\[CloseCurlyQuote]m going to leave that for you to figure out rather \
than writing it up. You have the tools! Once you have figured it out, you\
\[CloseCurlyQuote]ll see why it is called a voltage divider.\n\nUsing the \
example from the previous section to plug in values. What is the voltage on \
the upper connector of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "b0e47920-acd3-4644-a4c9-8d50c15a09c6"],
 "?"
}], "Text",
 CellChangeTimes->{{3.978766364393445*^9, 3.97876646668801*^9}, {
  3.978766641401043*^9, 3.9787667417852287`*^9}, {3.979369000713619*^9, 
  3.9793690272374287`*^9}},ExpressionUUID->"18d7a0e0-17f5-4ebe-af08-\
377efa574deb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Capacitors \[LongDash] But First Batteries", "Section",
 CellChangeTimes->{{3.9772897343047647`*^9, 3.977289742778789*^9}, {
  3.977557185041368*^9, 3.977557199818494*^9}, {3.977560920391399*^9, 
  3.9775609285410013`*^9}, {3.977561704893649*^9, 3.9775617124536877`*^9}, {
  3.977562699357638*^9, 3.977562712075577*^9}, {3.977935734236527*^9, 
  3.977935734945239*^9}, {3.977939102048142*^9, 3.977939102844123*^9}, {
  3.977989437232789*^9, 3.977989437465143*^9}, {3.977989470213393*^9, 
  3.977989508390332*^9}, {3.97798954149605*^9, 3.977989543660515*^9}, {
  3.977990021719898*^9, 3.977990078606063*^9}, {3.977992894877846*^9, 
  3.97799289522244*^9}, {3.978139264324004*^9, 3.978139271216731*^9}, {
  3.978139302793354*^9, 3.978139304471149*^9}, {3.978766340445903*^9, 
  3.978766347061178*^9}, {3.9787667500384197`*^9, 3.9787667571611843`*^9}, {
  3.978768675909679*^9, 
  3.9787686816086273`*^9}},ExpressionUUID->"93a7e3a7-a9e6-4854-ac2a-\
1caeea477211"],

Cell[TextData[{
 "When I introduced charge, I hope I convinced you that charge can never pile \
up. And indeed it cannot!! Except there is one exception, that uses a \
loophole in the language. It is a specially-designed device that ",
 StyleBox["kind of",
  FontSlant->"Italic"],
 " allows charge to pile up. "
}], "Text",
 CellChangeTimes->{{3.978766364393445*^9, 3.97876646668801*^9}, {
  3.978766641401043*^9, 3.978766854009482*^9}, {3.9787674531483507`*^9, 
  3.978767478526486*^9}, {3.978767527697895*^9, 3.9787676492103443`*^9}, {
  3.978768097373432*^9, 3.978768102415539*^9}, {3.9787691750965767`*^9, 
  3.9787691905992403`*^9}},ExpressionUUID->"e20f4428-269a-48b6-a8b8-\
074f08245998"],

Cell["\<\
Let\[CloseCurlyQuote]s revisit batteries. A battery can emit current for \
quite a while. In fact, the batteries we are using are \
spec\[CloseCurlyQuote]d to emit 3000mAh in total, which we did a bit of math \
and discovered was 10,800 Coulombs. Does a battery have 10,800 Coulombs piled \
up in it?

Seminar on that.

That will get you wondering what even is a battery!\
\>", "Text",
 CellChangeTimes->{{3.978766364393445*^9, 3.97876646668801*^9}, {
  3.978766641401043*^9, 3.978766854009482*^9}, {3.9787674531483507`*^9, 
  3.978767478526486*^9}, {3.978767527697895*^9, 3.9787676492103443`*^9}, {
  3.978768097373432*^9, 3.978768102415539*^9}, {3.9787691941809473`*^9, 
  3.9787692299161577`*^9}},ExpressionUUID->"4adba4bc-10a0-4d8f-a037-\
b2f6a0459384"],


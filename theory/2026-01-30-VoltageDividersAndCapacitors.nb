   3.978771265452713*^9}, {3.978771482978774*^9, 3.978771542952291*^9}, {
   3.9787715793273783`*^9, 3.978771586615888*^9}, 
   3.979371292765265*^9},ExpressionUUID->"07a61ee2-165a-46fb-8e92-\
a5fcac69ab13"],


Cell["\<\
We are going to study what happens to this capacitor over the course of 1 \
second by dividing up time into little chunks that are 0.1 second long. Let\
\[CloseCurlyQuote]s do it.\
\>", "Text",
 CellChangeTimes->{{3.978768919926632*^9, 3.978769149469356*^9}, {
  3.978769240461761*^9, 3.9787692410074577`*^9}, {3.9787692884346743`*^9, 

Cell[TextData[{
 "\n\nHINT/DISCUSSION ON (b), (c), and (d): \n\nYou can make rough estimates \
by putting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    RowBox[{"R", " ", "C"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "48acb814-72e0-4b4e-96aa-f5037e1606e1"],
 " into the exact answer,\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", "t", ")"}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["V", "0"], "(", 
     RowBox[{"1", "-", 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "T"}]]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc538f3f-3df5-4770-b61d-c635a8fa37e2"],
 ",\n\nand then graphing it. On the facing page is a graph that is \
sufficiently detailed, that you should be able to read off the times to the \
nearest thousandth or so of a second.\n\nFor part (d) you just take the \
inverse of the time to go from 1V to 3V and you have the number of times per \
second that can happen. Then divide by 2, to account for both charge and \
discharge."
}], "Text",
 CellChangeTimes->{{3.98415024502713*^9, 3.98415027287353*^9}, {
  3.984150305845222*^9, 3.984150377251152*^9}, {3.984150418413294*^9, 
  3.984150460560698*^9}, {3.984150600966851*^9, 3.984150604128446*^9}, {
  3.984150747838572*^9, 3.9841508202458267`*^9}, {3.9841511206897984`*^9, 
  3.9841511217840652`*^9}, {3.9841512186312532`*^9, 3.984151263539771*^9}, {
  3.984153326052678*^9, 
  3.9841533285518436`*^9}},ExpressionUUID->"1edcbc77-046d-4d6b-b371-\
483375dcb06e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"spacings", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0.000", ",", "0.040", ",", "0.002"}], "]"}], ",", 
     "Automatic"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "t_", "]"}], ":=", 
   RowBox[{"4", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "T"}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0.0", ",", "0.04"}], "}"}], ",", " ", 
   RowBox[{"Ticks", "->", "spacings"}], ",", " ", 
   RowBox[{"GridLines", "->", "spacings"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9841506556902313`*^9, 3.984150711505671*^9}, {
  3.984150824491292*^9, 3.9841508542202253`*^9}, {3.984150944884492*^9, 

Cell[CellGroupData[{

Cell["1. Both Series and Parallel Resistors in the Same Circuit!!", \
"Subsection",
 CellChangeTimes->{{3.9841413107635937`*^9, 3.9841413110641823`*^9}, {
  3.9841440034128447`*^9, 3.984144009547482*^9}, {3.984149557869149*^9, 
  3.98414956253094*^9}},ExpressionUUID->"cad4486b-e804-489e-a17a-\
9ddf3cbae82d"],

Cell[TextData[{
 "Hint: First collapse the two 3k\[CapitalOmega] resistors that are in \
parallel into a single equivalent resistor using\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "equivalent"], "=", 
    FractionBox["1", 
     RowBox[{
      FractionBox["1", 
       SubscriptBox["R", "1"]], "+", 
      FractionBox["1", 
       SubscriptBox["R", "2"]]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9b549f7-c1e0-40ec-9149-33af0f9f2eda"],
 "\n\nYou should get something smaller than either ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "44fe43fd-df9c-42fa-8cea-3f5687aac658"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ef841c3-d253-4129-9eb2-c65cf3e6b935"],
 ". Now that it is collapsed into a single equivalent resistor, you have an \
ordinary voltage divider problem."
}], "Text",
 CellChangeTimes->{{3.984144015352901*^9, 3.984144171570553*^9}, {
  3.9841495769466743`*^9, 3.984149578988297*^9}, {3.984149883372814*^9, 
  3.984149934253778*^9}},ExpressionUUID->"8cc13bbb-c731-4174-9124-\
186870910126"],


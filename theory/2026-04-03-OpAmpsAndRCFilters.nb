Cell[TextData[{
 "If the capacitor labeled ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4ac3eea-f05c-43ca-8752-ff580eef18ca"],
 " was actually a resistance with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"R", "'"}], "=", 
    FractionBox["1", 
     RowBox[{"2", "\[Pi]", " ", "f", "\[VeryThinSpace]", "C"}]]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "10567b5f-df78-4187-842b-dff1dd3391c5"],
 ", then in that case you should be able to see that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "out"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da5adc3b-9b2d-49db-b149-90de2682e24d"],
 " is in a voltage divider configuration and you\[CloseCurlyQuote]d have:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "out"], "=", 
    RowBox[{
     SubscriptBox["V", "in"], 
     StyleBox[
      FractionBox[
       RowBox[{"R", "'"}], 
       RowBox[{"R", "+", 
        RowBox[{"R", "'"}]}]],
      FontSize->18]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2bca0f8-f6c0-4268-b5a7-e1b73fd715eb"],
 "\n\nThe capacitor is not a resistor. Weirdly, the actual relation is:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "out"], "=", 
    RowBox[{
     SubscriptBox["V", "in"], 
     StyleBox[
      FractionBox[
       RowBox[{"R", "'"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["R", "2"], "+", 
         SuperscriptBox[
          RowBox[{"R", "'"}], "2"]}]]],
      FontSize->18]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "791a5822-a6dd-49bc-b0d6-489be2ee0c1b"],
 "\n\n(a) If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    RowBox[{"3000", "\[CapitalOmega]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c15dda5-75f7-4ed8-920b-fbe33e20943f"],
 ", and the applied signal ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "in"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "307ffe4f-ac6e-4c3a-84f9-b91bbbcd947e"],
 " has size 10V and frequency 50Hz, and using your answer for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bccfccf2-a641-417c-8dd1-16fe1c301867"],
 " from 7(a) what is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "out"], "=", 
    RowBox[{
     SubscriptBox["V", "in"], 
     StyleBox[
      FractionBox[
       RowBox[{"R", "'"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["R", "2"], "+", 
         SuperscriptBox[
          RowBox[{"R", "'"}], "2"]}]]],
      FontSize->18]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4644aae-2319-4bad-97da-b26e3915805c"],
 "?\n\n(b) Keeping ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    RowBox[{"3000", "\[CapitalOmega]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d310e91-a6d8-42ab-874d-4f1cb2cf1173"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "in"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5ab52a0-cc60-4ec0-99e7-e25092b2f305"],
 " having size 10V, but this time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "=", 
    RowBox[{"5000", "Hz"}]}], TraditionalForm]],
  InitializationCell->True,
  FormatType->TraditionalForm,ExpressionUUID->
  "facc0fb9-b632-4785-844f-991c1a419e1c"],
 ", and using your answer for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "''"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d44d23a0-c8ac-448c-ba10-5713282a608a"],
 " from 7(b), what is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "out"], "=", 
    RowBox[{
     SubscriptBox["V", "in"], 
     StyleBox[
      FractionBox[
       RowBox[{"R", "''"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["R", "2"], "+", 
         SuperscriptBox[
          RowBox[{"R", "''"}], "2"]}]]],
      FontSize->18]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "168c2408-1a44-47f3-9d09-337a95e6695a"],
 "?"
}], "Text",
 CellChangeTimes->{{3.98414331664878*^9, 3.984143544468636*^9}, {
